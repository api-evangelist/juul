{
  "issuer": "https://www.juul.com",
  "authorization_endpoint": "https://www.juul.com/sso",
  "token_endpoint": "https://www.juul.com/oauth/token",
  "userinfo_endpoint": "https://www.juul.com/oauth/token/info",
  "revocation_endpoint": "https://www.juul.com/oauth/revoke",
  "response_types_supported": [
    "code",
    "token",
    "password",
    "none"
  ],
  "subject_types_supported": [
    "public"
  ],
  "scopes_supported": [
    "conx_web",
    "mobileapp",
    "keychain",
    "keychain-force-rebuild"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_post",
    "client_secret_basic"
  ],
  "claims_supported": [
    "exp",
    "iat",
    "iss",
    "locale",
    "sub"
  ],
  "grant_types_supported": [
    "authorization_code",
    "refresh_token",
    "urn:ietf:params:oauth:grant-type:jwt-bearer"
  ]
}
